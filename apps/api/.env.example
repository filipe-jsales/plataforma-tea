PORT=3000

# Postgres (ver docker-compose.yml na raiz do monorepo)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=plataforma_tea
DB_PASSWORD=plataforma_tea
DB_DATABASE=plataforma_tea
# true para bancos gerenciados que exigem SSL (Neon, Supabase). Local: false.
DB_SSL=false

JWT_SECRET=troque-este-valor-em-producao
JWT_EXPIRES_IN=8h

# Origem do frontend (Vite dev server) liberada no CORS
WEB_ORIGIN=http://localhost:5173
